# Database (PostgreSQL for Docker/production, SQLite default for local development)
DATABASE_URL=postgresql://incubrix_user:incubrix_password@localhost:5432/incubrix_visibility
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./incubrix.db

# Redis (for background queue / cache)
REDIS_URL=redis://localhost:6379/0

# Search Engine APIs (optional, fallback simulator used if blank)
SEARCH_API_KEY=your_serpapi_key_here

# AI Assistant APIs (optional, fallback simulator used if blank)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Performance & Auditing
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# App Secret
APP_SECRET=incubrix-production-secret-key-change-this

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
